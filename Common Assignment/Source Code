from collections import deque

def kahn_topological_sort(graph):
    indegree = {v: 0 for v in graph}
    for u in graph:
        for v in graph[u]:
            indegree[v] += 1

    q = deque(v for v in graph if indegree[v] == 0)
    order = []

    while q:
        u = q.popleft()
        order.append(u)
        for v in graph[u]:
            indegree[v] -= 1
            if indegree[v] == 0:
                q.append(v)

    return order, len(order) != len(graph)

def dfs_topological_sort(graph):
    state = {v: 0 for v in graph}   # 0=unvisited, 1=visiting, 2=visited
    stack = []
    cycle = False

    def dfs(u):
        nonlocal cycle
        state[u] = 1
        for v in graph[u]:
            if state[v] == 1:
                cycle = True
                return
            if state[v] == 0:
                dfs(v)
                if cycle:
                    return
        state[u] = 2
        stack.append(u)

    for v in graph:
        if state[v] == 0:
            dfs(v)
        if cycle:
            break

    return ([], True) if cycle else (stack[::-1], False)

graph = {
    "Programming": ["Data Structures", "Database"],
    "Data Structures": ["Algorithms"],
    "Algorithms": ["Machine Learning", "AI"],
    "Database": ["AI"],
    "Machine Learning": [],
    "AI": []
}

print("BFS:", kahn_topological_sort(graph))
print("DFS:", dfs_topological_sort(graph))
